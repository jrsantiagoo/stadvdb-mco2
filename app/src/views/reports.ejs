<%- include('partials/header') %>
<%
  const int = (n) => Number(n).toLocaleString();
  const money = (n) => Number(n).toFixed(2);
  const pct = (n) => (n * 100).toFixed(1) + '%';
%>

<h1>Reports</h1>

<h2>Fragments</h2>
<table class="grid">
  <thead>
    <tr>
      <th>Node</th><th>Holds</th><th>Status</th>
      <th class="num">Films</th><th class="num">Total stock</th><th class="num">Avg rate</th>
      <th class="num" title="Rows on this fragment that the fragmentation rule assigns to the other fragment">Misplaced rows</th>
    </tr>
  </thead>
  <tbody>
    <% for (const n of nodes) { %>
      <tr>
        <td>Node <%= n.nodeId %></td>
        <td><%= roles[n.nodeId] %></td>
        <td><span class="status <%= n.up ? 'up' : 'down' %>"><%= n.up ? 'Up' : `Down: ${n.error}` %></span></td>
        <% if (n.up) { %>
          <td class="num"><%= int(n.totals.films) %></td>
          <td class="num"><%= int(n.totals.stock) %></td>
          <td class="num"><%= n.totals.films ? money(n.totals.rateSum / n.totals.films) : '—' %></td>
          <td class="num"><%= n.nodeId === 1 ? '—' : int(n.misplaced) %></td>
        <% } else { %>
          <td class="num">—</td><td class="num">—</td><td class="num">—</td><td class="num">—</td>
        <% } %>
      </tr>
    <% } %>
    <% if (check) { %>
      <tr class="total">
        <td colspan="3">Node 2 + Node 3</td>
        <td class="num"><%= int(check.sum.films) %></td>
        <td class="num"><%= int(check.sum.stock) %></td>
        <td></td>
        <td class="num"><%= int(check.misplaced) %></td>
      </tr>
    <% } %>
  </tbody>
</table>

<% if (!check) { %>
  <p class="muted">Not every node is up, so the fragments can't be checked against Node 1.</p>
<% } else if (check.filmsMatch && check.stockMatch && check.misplaced === 0) { %>
  <p class="notice ok">Node 2 + Node 3 match Node 1 in film count and total stock, and every row is on the right fragment.</p>
<% } else { %>
  <p class="notice warn">
    <% const gap = Math.abs(check.sum.films - nodes[0].totals.films); %>
    <% if (!check.filmsMatch) { %>Node 2 + Node 3 have <%= int(gap) %> <%= check.sum.films < nodes[0].totals.films ? 'fewer' : 'more' %> <%= gap === 1 ? 'film' : 'films' %> than Node 1. <% } %>
    <% if (!check.stockMatch) { %>Their total stock is <%= int(Math.abs(check.sum.stock - nodes[0].totals.stock)) %> <%= check.sum.stock < nodes[0].totals.stock ? 'lower' : 'higher' %> than Node 1's. <% } %>
    <% if (check.misplaced) { %><%= int(check.misplaced) %> <%= check.misplaced === 1 ? 'row is' : 'rows are' %> on the wrong fragment. <% } %>
    Some changes may not have been replicated yet.
  </p>
<% } %>
<p class="muted small">Each node is read separately, so a write that lands between those reads can cause a brief mismatch. Reload to recheck.</p>

<h2>By rental rate</h2>
<% if (!byRate.length) { %>
  <p class="muted">No films.</p>
<% } else { %>
  <table class="grid">
    <thead>
      <tr><th class="num">Rental rate</th><th class="num">Films</th><th class="num">Share of films</th><th class="num">Total stock</th><th class="num">Avg stock per film</th></tr>
    </thead>
    <tbody>
      <% for (const r of byRate) { %>
        <tr>
          <td class="num"><%= money(r.k) %></td>
          <td class="num"><%= int(r.films) %></td>
          <td class="num"><%= pct(r.share) %></td>
          <td class="num"><%= int(r.stock) %></td>
          <td class="num"><%= r.avgStock.toFixed(1) %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>

<h2>By rental duration</h2>
<% if (!byDuration.length) { %>
  <p class="muted">No films.</p>
<% } else { %>
  <table class="grid">
    <thead>
      <tr><th class="num">Days</th><th class="num">Films</th><th class="num">Share of films</th><th class="num">Total stock</th><th class="num">Avg rental rate</th></tr>
    </thead>
    <tbody>
      <% for (const r of byDuration) { %>
        <tr>
          <td class="num"><%= r.k %></td>
          <td class="num"><%= int(r.films) %></td>
          <td class="num"><%= pct(r.share) %></td>
          <td class="num"><%= int(r.stock) %></td>
          <td class="num"><%= money(r.avgRate) %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>

<%- include('partials/footer') %>
