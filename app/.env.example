# Which node this copy of the app runs on: 1 (central), 2 or 3.
NODE_ID=1
PORT=3000

# Isolation level for every transaction the app opens.
# One of: READ UNCOMMITTED, READ COMMITTED, REPEATABLE READ, SERIALIZABLE
ISOLATION_LEVEL=READ COMMITTED

# Seconds a statement waits for a row lock before giving up (MySQL default: 50).
LOCK_WAIT_TIMEOUT=10

# Connection details for all three nodes. Every node's app needs all three,
# because reads fail over and writes are replicated across nodes.
NODE1_HOST=127.0.0.1
NODE1_PORT=3306
NODE1_USER=mco2
NODE1_PASSWORD=change-me
NODE1_DATABASE=mco2_db

NODE2_HOST=127.0.0.1
NODE2_PORT=3307
NODE2_USER=mco2
NODE2_PASSWORD=change-me
NODE2_DATABASE=mco2_db

NODE3_HOST=127.0.0.1
NODE3_PORT=3308
NODE3_USER=mco2
NODE3_PASSWORD=change-me
NODE3_DATABASE=mco2_db
